    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst clean = raw.replace(/```json|```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(clean);\n  const trigger = $('Gmail Trigger').first().json;\n\n  return [{ json: {\n    category:   parsed.category   || 'diger',\n    priority:   parsed.priority   ?? 3,\n    summary:    parsed.summary    || trigger.subject,\n    event_date: parsed.event_date ?? null,\n    job_score:  parsed.job_score  ?? null,\n    reply:      parsed.reply      || '',        // ← EKLENDİ\n    from:       trigger.from,\n    subject:    trigger.subject,\n    snippet:    trigger.snippet   || '',\n    messageId:  trigger.id,\n    threadId:   trigger.threadId\n  }}];\n\n} catch(e) {\n  const trigger = $('Gmail Trigger').first().json;\n\n  return [{ json: {\n    category:   'diger',\n    priority:   2,\n    summary:    trigger.subject,\n    event_date: null,\n    job_score:  null,\n    reply:      '',                             // ← EKLENDİ\n    from:       trigger.from,\n    subject:    trigger.subject,\n    snippet:    trigger.snippet || '',\n    messageId:  trigger.id,\n    threadId:   trigger.threadId\n  }}];\n}"
      },
