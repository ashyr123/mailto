  "nodes": [
    {
      "parameters": {
        "jsCode": "// 1. Satır düzeltildi: Veri doğrudan 'text' içinden alınıyor\nconst raw = $input.first().json.text ? $input.first().json.text.trim() : \"\";\n\n// Markdown formatındaki ```json ve ``` işaretlerini temizler\nconst clean = raw.replace(/```json|```/g, '').trim();\n\ntry {\n    const parsed = JSON.parse(clean);\n    return [{ json: { ...parsed } }];\n} catch(e) {\n    // Eğer gelen metin JSON formatında değilse hata vermemesi için fallback\n    return [{ json: { is_spam: false, reason: 'parse_error' } }];\n}"
      },
